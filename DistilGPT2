lt"}],"source":["# now we are going to tokenize our dataset using the same tokeizer algorithm but a differet method\n","# this is because Because the dataset needs encoded numerical inputs for the model, and we also want to process batches of questions and handle overly long inputs.\n","\n","\"\"\"I use the huggingface Datasets map function to apply the preprocessing function \n","over the entire dataset. By setting batched=True,\n","I process multiple elements of the dataset at once and \n","increase the number of processes with num_proc=4. \n","Finally, I remove the “questions” column because I won’t need it now.\n","\"\"\"\n","def tokenize_function(examples):\n","    return tokenizer(examples[\"question\"], truncation = True) #truncation=True allows overly long inputs to be shortened to an allowed length.\n","\n","tokenized_datasets = dataset.map(\n","    tokenize_function,\n","    batched = True,\n","    num_proc = 4, \n","    remove_columns =[\"question\"] \n","\n",")\n","\n","\n","tokenized_datasets"]},{"cell_type":"markdown","id":"67d20fb5","metadata":{"papermill":{"duration":0.004103,"end_time":"2026-11-02T11:20:09.542934+00:00","exception":false,"start_time":"2026-11-02T11:20:09.538831+00:00","status":"completed"},"tags":[]},"source":["Data Processing"]},{"cell_type":"code","execution_count":9,"id":"2e3c9577","metadata":{"execution":{"iopub.execute_input":"2026-11-02T11:20:09.552819Z","iopub.status.busy":"2026-11-02T11:20:09.552403Z","iopub.status.idle":"2026-11-02T11:20:12.715585Z","shell.execute_reply":"2026-11-02T11:20:12.714326Z"},"papermill":{"duration":3.170571,"end_time":"2026-11-02T11:20:12.717657+00:00","exception":false,"start_time":"2026-11-02T11:20:09.547086+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"3d47acc5b58a44a389089ccfef1206c8","version_major":2,"version_minor":0},"text/plain":["Map (num_proc=4):   0%|          | 0/87599 [00:00<?, ? examples/s]"]},"metadata":{},"outpu